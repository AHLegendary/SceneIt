VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

TMDB_READ_TOKEN=your-tmdb-read-access-token
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key   # server only: saves searched movies to the movies table

# Only for `npm run ratings` (scripts/fetch-ratings.mjs). Free key: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your-omdb-api-key

# Only for `npm run demo-users` (scripts/seed-demo-users.mjs). Password for every demo account.
# Repo is public: pick your own and share it with the team privately (8+ characters).
DEMO_PASSWORD=your-demo-password
